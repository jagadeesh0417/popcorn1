# =============================================================================
# Blue Dino (popcorn store) environment variables
# Copy this file to `.env.local` for local dev, or set each variable in your
# deployment (Vercel project settings) — do not commit real secrets.
# =============================================================================

# --- MongoDB ---
# Connection string. Supports Mongo Atlas (recommended) or any Mongo-compatible URI.
MONGODB_URI=mongodb://localhost:27017/popcorn

# --- NextAuth ---
# Used to sign the admin session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Canonical site URL (required for NextAuth in production)
NEXTAUTH_URL=https://your-domain.example

# --- Razorpay payment gateway ---
# Server-side credentials. Used by /api/razorpay/create-order and
# /api/razorpay/verify. If these are NOT set, the payment routes fall back to
# the Razorpay keys saved under Admin > Settings > Payments (MongoDB).
RAZORPAY_KEY_ID=rzp_test_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret configured in the Razorpay Dashboard (Settings > Webhooks).
# Used by /api/razorpay/webhook to verify x-razorpay-signature over the raw
# body. If unset, webhooks are rejected with 500 — callbacks still work, but
# the confirmation page would then rely on polling/reconcile instead.
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (product/admin image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxx

# --- Contact / SMTP (contact form) ---
# To whom the contact form is delivered.
CONTACT_EMAIL=bluedino.snacks@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Publicly exposed (NEXT_PUBLIC_*) values ---
# These are bundled into the browser build, so never put secrets here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_live_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=918197175807
NEXT_PUBLIC_EMAIL=bluedino.snacks@gmail.com
NEXT_PUBLIC_FSSAI_NUMBER=21226198000399

# --- Site identity (metadata, canonical, Open Graph) ---
# Set to the live domain in production; defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Social profiles ---
# The Instagram profile URL ships as a built-in default in src/lib/brand.ts, so
# the Instagram section, footer icon and schema.org sameAs always point at the
# live account. Set this only if the account ever moves. NOTE: the handle in the
# URL is the real account handle - do not "brand" it, just copy the new link.
NEXT_PUBLIC_INSTAGRAM_URL=
# Legacy/unused: the Instagram heading shows "Blue Dino on Instagram", not an
# @handle. Safe to leave blank.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Brand artwork (optional) ---
# Leave blank to use the local drop-in slots in public/brand/ (see
# public/brand/README.md). Full https:// URLs are also accepted.
NEXT_PUBLIC_BRAND_HEADER_LOGO=
NEXT_PUBLIC_BRAND_FOOTER_LOGO=
NEXT_PUBLIC_BRAND_FAVICON=
NEXT_PUBLIC_BRAND_APPLE_TOUCH_ICON=
NEXT_PUBLIC_BRAND_OG_IMAGE=

# --- Admin setup ---
# Used by /api/setup-admin, /api/update-admin-password and scripts/seed-admin.mjs.
# IMPORTANT: Only enable while creating the initial admin account, then turn off.
NEXT_PUBLIC_ENABLE_ADMIN_SETUP=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
