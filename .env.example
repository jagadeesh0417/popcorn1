# =============================================================================
# Poprika (popcorn store) environment variables
# Copy this file to `.env.local` for local dev, or set each variable in your
# deployment (Vercel project settings) — do not commit real secrets.
# =============================================================================

# --- MongoDB ---
# Connection string. Supports Mongo Atlas (recommended) or any Mongo-compatible URI.
MONGODB_URI=mongodb://localhost:27017/popcorn

# --- NextAuth ---
# Used to sign the admin session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Canonical site URL (required for NextAuth in production)
NEXTAUTH_URL=https://your-domain.example

# --- Razorpay payment gateway ---
# Server-side credentials. Used by /api/razorpay/create-order and
# /api/razorpay/verify. If these are NOT set, the payment routes fall back to
# the Razorpay keys saved under Admin > Settings > Payments (MongoDB).
RAZORPAY_KEY_ID=rzp_test_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudinary (product/admin image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxx

# --- Contact / SMTP (contact form) ---
# To whom the contact form is delivered.
CONTACT_EMAIL=poprika.official@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Publicly exposed (NEXT_PUBLIC_*) values ---
# These are bundled into the browser build, so never put secrets here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_live_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=918197175807
NEXT_PUBLIC_FSSAI_NUMBER=21226198000399
NEXT_PUBLIC_ANNOUNCEMENT_TEXT=Free shipping on orders over 329
NEXT_PUBLIC_HERO_VARIANT=single

# --- Admin setup ---
# IMPORTANT: Only enable while creating the initial admin account, then turn off.
NEXT_PUBLIC_ENABLE_ADMIN_SETUP=true
